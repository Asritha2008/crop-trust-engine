    {
      "name": "POST /predict (Recommend)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verdict is recommend\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.verdict).to.eql(\"recommend\");",
              "});",
              "",
              "pm.test(\"Top crops has at least one prediction\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.top_crops).to.be.an(\"array\").that.is.not.empty;",
              "    pm.expect(jsonData.top_crops[0]).to.have.property(\"crop\");",
              "    pm.expect(jsonData.top_crops[0]).to.have.property(\"probability\");",
              "});",
              "",
              "pm.test(\"Stability and trust score are valid\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.stability).to.be.a(\"number\").that.is.at.least(0).and.at.most(1);",
              "    pm.expect(jsonData.trust_score).to.be.a(\"number\").that.is.at.least(0).and.at.most(100);",
              "});",
              "",
              "pm.test(\"OOD flags indicate in-distribution\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.ood.flagged).to.be.false;",
              "    pm.expect(jsonData.ood.percentile).to.be.a(\"number\");",
              "});",
              "",
              "pm.test(\"Required keys and metadata are present\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"conformal_set\");",
              "    pm.expect(jsonData).to.have.property(\"measure_next\");",
              "    pm.expect(jsonData).to.have.property(\"explanation\").that.is.a(\"string\");",
              "    pm.expect(jsonData).to.have.property(\"model_version\").that.is.a(\"string\");",
              "});",
              "",
              "pm.test(\"No traceback in response\", function () {",
              "    pm.expect(pm.response.text()).to.not.include(\"Traceback\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
