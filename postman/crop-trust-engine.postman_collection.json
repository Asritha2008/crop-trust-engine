              "",
              "pm.test(\"Batch summary has count 3 and model_version\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"model_version\").that.is.a(\"string\");",
              "    pm.expect(jsonData.count).to.eql(3);",
              "    pm.expect(jsonData.results).to.be.an(\"array\").with.lengthOf(3);",
              "});",
              "",
              "pm.test(\"Results contain row_index and predictions in order\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.results.forEach(function (res, idx) {",
              "        pm.expect(res.row_index).to.eql(idx);",
              "        pm.expect(res).to.have.property(\"verdict\");",
              "        pm.expect(res).to.have.property(\"explanation\");",
              "    });",
              "});",
              "",
              "pm.test(\"No traceback in response\", function () {",
              "    pm.expect(pm.response.text()).to.not.include(\"Traceback\");",
